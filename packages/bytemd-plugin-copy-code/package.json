{
  "name": "@fastx/bytemd-plugin-copy-code",
  "private": false,
  "version": "1.0.0",
  "description": "ByteMD plugin to support copy code",
  "license": "MIT",
  "author": "ShenBao",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShenBao/fastx-md-playground.git",
    "directory": "packages/bytemd-plugin-copy-code"
  },
  "types": "./dist/index.d.ts",
  "module": "./dist/index.mjs",
  "main": "./dist/index.js",
  "unpkg": "./dist/index.umd.js",
  "jsdelivr": "./dist/index.umd.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
