    "./locales/*": "./locales/*",
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "locales"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependencies": {
    "bytemd": "^1.22.0"
  },
  "dependencies": {
    "clipboard": "^2.0.11",
    "unist": "^0.0.1",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@types/unist": "^3.0.3"
  }
}
